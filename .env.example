NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your_supabase_publishable_key
# NEXT_PUBLIC_SUPABASE_ANON_KEY is also supported for older Supabase naming.
NEXT_PUBLIC_APP_URL=http://localhost:3000
APP_URL=http://localhost:3000

# Launch safety defaults. Medical clients can sign up, but PHI-capable provider
# workflows stay gated until contracts, BAAs, and provider settings are approved.
MEDICAL_PRIVACY_MODE=true
ENABLE_LIVE_STRIPE_CHECKOUT=false

# Optional: enables platform-wide tenant admin view for this email only.
# Without this, admin views stay scoped to the signed-in tenant.
PLATFORM_OWNER_EMAIL=
SUPABASE_SERVICE_ROLE_KEY=

# Step 5 WhatsApp beta lane. Leave blank until you are ready to pay for/use Unipile.
UNIPILE_API_KEY=
UNIPILE_DSN=
UNIPILE_WEBHOOK_SECRET=

# Step 6 voice lane. Leave blank until you are ready to use Vapi live.
VAPI_API_KEY=

# AI lane. Do not send PHI unless the provider account and workflow are approved.
OPENAI_API_KEY=

# Step 10 billing. Leave blank until you are ready to use Stripe live.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Step 11 booking sync. Leave blank until you are ready to use Cal.com live.
CALCOM_API_KEY=
CALCOM_WEBHOOK_SECRET=

# Step 12 official WhatsApp lane. Leave blank until provider onboarding is approved.
WHATSAPP_OFFICIAL_PROVIDER=360dialog
WHATSAPP_OFFICIAL_API_KEY=
WHATSAPP_OFFICIAL_WEBHOOK_SECRET=

# Automation lane. Leave blank until a covered runtime/provider is approved.
N8N_WEBHOOK_URL=
