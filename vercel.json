{
  "cleanUrls": true,
  "trailingSlash": true,
  "rewrites": [
    {
      "source": "/systems/voice-agent/",
      "destination": "/systems/voice-agent/index.html"
    },
    {
      "source": "/systems/voice-agent",
      "destination": "/systems/voice-agent/index.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "index, follow"
        }
      ]
    }
  ]
}
